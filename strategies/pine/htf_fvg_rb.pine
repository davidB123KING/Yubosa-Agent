//@version=6
strategy("HTF FVG + 15m RB Strategy", overlay = true,
     initial_capital = 10000, default_qty_type = strategy.fixed, pyramiding = 1,
     margin_long = 1, margin_short = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0,
     max_boxes_count = 200, max_labels_count = 500, max_lines_count = 500)

