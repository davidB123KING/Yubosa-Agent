nwogMode = input.string("Samo short", "Kaj blokira", options = ["Samo short", "Po smeri gapa"], tooltip = "Samo short = vedno blokira short do dotika. Po smeri gapa = gap NAD ceno (gap down) blokira short, gap POD ceno (gap up) blokira long.", group = groupNWOG)
nwogMinGap = input.float(0.0, "Min. velikost gapa ($)", minval = 0.0, step = 0.5, tooltip = "Manjši gapi se ignorirajo (filter ta teden ne velja).", group = groupNWOG)
nwogIgnoreMin = input.int(15, "Ne štej dotika prvih X minut", minval = 0, tooltip = "Dotik gapa v prvih X minutah po odprtju tedna se ne upošteva - blokada ostane aktivna.", group = groupNWOG)
