filterHammerBull = input.bool(true, "Izloči bullish RB s hammerjem na dnu", tooltip = "Zrcalno: 1m sveča z najnižjo točko A+B ima dolg spodnji fitil in kratek zgornji.", group = groupPat)
starWickRatio    = input.float(1.0, "Min. razmerje fitil / telo", minval = 0.5, step = 0.1, tooltip = "1.0 = enako kot LuxAlgo (fitil daljši od telesa). Višje = strožje.", group = groupPat)
markFiltered     = input.bool(true, "Označi izločene RB-je", tooltip = "Na izločeni sveči nariše majhen siv ✘, da lahko preveriš filter.", group = groupPat)

